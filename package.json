{
  "name": "srcy",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "srcy": "dist/src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts test/*.test.tsx",
    "build": "tsc && node -e \"require('fs').chmodSync('dist/src/index.js', 0o755)\"",
    "prepare": "tsc && node -e \"require('fs').chmodSync('dist/src/index.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "preview": "tsx scripts/preview-shell.ts",
    "demo": "tsx scripts/demo.ts",
    "demo:gif": "agg --theme github-dark --font-size 14 --line-height 1.3 --fps-cap 12 --idle-time-limit 1.2 --font-family \"DejaVu Sans Mono\" docs/demo.cast docs/demo.gif",
    "prepublishOnly": "npm test && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "get-east-asian-width": "^1.6.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "description": "An IDE around the coding agent you already use. The agent stays native; srcy is the panes around it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sajjadriaj/srcy.git"
  },
  "keywords": [
    "claude-code",
    "codex",
    "coding-agent",
    "tmux",
    "tui",
    "diff",
    "review"
  ],
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ]
}
