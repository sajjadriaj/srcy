{
  "name": "ctui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "ctui": "dist/src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts test/*.test.tsx",
    "build": "tsc && node -e \"require('fs').chmodSync('dist/src/index.js', 0o755)\"",
    "prepare": "tsc && node -e \"require('fs').chmodSync('dist/src/index.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "preview": "tsx scripts/preview-shell.ts",
    "preview:gate": "tsx scripts/preview.tsx"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "get-east-asian-width": "^1.6.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.14.1",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8"
  }
}
